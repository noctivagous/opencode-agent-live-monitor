{
  "name": "opencode-agent-live-monitor",
  "version": "1.0.0",
  "type": "module",
  "description": "A real-time visualization dashboard for OpenCode agents. Watch the AI work live with a clean three-column interface: interactive project tree, active file workspace with visual change highlights, and activity explanations.",
  "main": "index.js",
  "bin": {
    "opencode-agent-live-monitor": "bin/opencode-agent-live-monitor.js"
  },
  "files": [
    "index.js",
    "bin/",
    "scripts/",
    "live-monitor-plugin.js",
    "server.js",
    "dashboard.html",
    "index.html",
    "index-tree.html",
    "index-treemap.html",
    "index-radial.html",
    "index-horizon.html",
    "monitor-tree.js",
    "monitor-highlights.js",
    "monitor-zoom.js",
    "monitor-preview.js",
    "monitor-badges.js",
    "monitor-legend.js",
    "monitor-chrome.css",
    "README.md"
  ],
  "scripts": {
    "test": "echo \"No tests yet\"",
    "start": "node server.js",
    "start:watch": "node --watch server.js",
    "launchd:install": "bash scripts/launchd-install.sh",
    "launchd:restart": "bash scripts/launchd-restart.sh",
    "launchd:uninstall": "bash scripts/launchd-uninstall.sh",
    "launchd:logs": "bash -lc 'tail -n 80 -f \"$HOME/Library/Logs/aicodeeditor-monitor.log\" \"$HOME/Library/Logs/aicodeeditor-monitor.err.log\"'"
  },
  "keywords": [
    "opencode-plugin",
    "opencode",
    "agent",
    "monitor",
    "dashboard"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ws": "^8.21.0"
  }
}
